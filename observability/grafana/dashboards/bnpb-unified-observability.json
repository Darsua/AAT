{
  "uid": "bnpb-unified-obs",
  "title": "Platform Overview & API Gateway",
  "tags": ["bnpb", "m2", "observability"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "links": [
    {
      "title": "BNPB Dashboards",
      "type": "dashboards",
      "tags": ["bnpb"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "Healthy Scrape Targets",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "green", "value": 14 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(up)",
          "legendFormat": "UP"
        }
      ]
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Active Aggregator Replicas",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(up{job=\"aggregator\"})",
          "legendFormat": "Replicas"
        }
      ]
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Active Gateway Replicas",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(up{job=\"client-api\"})",
          "legendFormat": "Replicas"
        }
      ]
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Satellite Stream Leader",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 },
              { "color": "orange", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(satellite_streaming)",
          "legendFormat": "Leader"
        }
      ]
    },
    {
      "id": 104,
      "type": "stat",
      "title": "AI Summarizer Circuit",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "CLOSED", "color": "green" },
                "1": { "text": "OPEN", "color": "red" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(bnpb_summarizer_circuit_open)",
          "legendFormat": "Circuit"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Throughput (RPS) by Service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{service}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{service}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 {{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Error Rates (4xx / 5xx) by Service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (service, status) (rate(http_requests_total{status=~\"[45]..\"}[1m]))",
          "legendFormat": "{{service}} HTTP {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "OAuth2 Token Issuance & Authentication Failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (grant_type) (rate(auth_tokens_issued_total[1m]))",
          "legendFormat": "issued ({{grant_type}})"
        },
        {
          "expr": "sum by (reason) (rate(auth_token_failures_total[1m]))",
          "legendFormat": "auth failure ({{reason}})"
        },
        {
          "expr": "sum by (reason) (rate(auth_rejections_total[1m]))",
          "legendFormat": "gateway rejection ({{reason}})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Gateway Priority QoS Shedding (HTTP 429) vs Admitted Traffic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{service=\"client-api\"}[1m]))",
          "legendFormat": "client-api HTTP {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-Replica HTTP Request Distribution (HA Load Balancing)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (service, instance) (rate(http_requests_total{service=~\"aggregator|client-api\"}[1m]))",
          "legendFormat": "{{service}} @ {{instance}}"
        }
      ]
    }
  ]
}
