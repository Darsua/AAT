# ==============================================================================
# BNPB Hazard Aggregation & Early Warning System — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
CLIENT_API_PORT=8080
MOCK_BMKG_PORT=8081
MOCK_PVMBG_PORT=8082
AGGREGATOR_PORT=8083
AUTH_PORT=8084
DASHBOARD_PORT=8085
SUMMARIZER_PORT=8087
REDPANDA_PORT=19092
STORE_AQUA_PORT=5433
STORE_RUBY_PORT=5434
STORE_AKANE_PORT=5435
AGGREGATOR_2_PORT=18083
AGGREGATOR_3_PORT=28083

# ------------------------------------------------------------------------------
# Canonical Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=bnpb_user
POSTGRES_PASSWORD=
POSTGRES_DB=bnpb_hazards
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=

# ------------------------------------------------------------------------------
# Event Streaming (Redpanda / Kafka)
# ------------------------------------------------------------------------------
REDPANDA_BROKERS=redpanda:9092
KAFKA_TOPIC_HAZARDS=bnpb.hazard-events
REDPANDA_TOPIC_FIELD_REPORTS=bnpb.field-reports
CONSUMER_GROUP_FIELD_REPORTS=bnpb-aggregator-field-reports
KAFKA_TOPIC_PARTITIONS=3
CONSUMER_GROUP_DASHBOARD=bnpb-dashboard-group
CONSUMER_GROUP_NOTIFIER=bnpb-notifier-group
CONSUMER_GROUP_SUMMARIZER=bnpb-summarizer-group
NOTIFIER_RECEIPT_LOG=/tmp/notifier-receipts.jsonl
FIELD_TEAM_RECEIVER_URL=

# ------------------------------------------------------------------------------
# Upstream Mock Services & Credentials
# ------------------------------------------------------------------------------
BMKG_URL=http://mock-bmkg:8081
BMKG_API_KEY=

PVMBG_URL=http://mock-pvmbg:8082
PVMBG_TOKEN=
# PVMBG response delay in milliseconds (random between MIN and MAX; set both to 3000 for a fixed 3 s)
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000

# Coastal Sensor Network (#29)
SENSOR_PANTAI_URL=http://sensor-pantai:8080
PANTAI_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Aggregator Ingestion Worker
# ------------------------------------------------------------------------------
POLL_INTERVAL_SECS=3
# Coastal buoy sensor poller (#29)
COASTAL_POLL_INTERVAL_SECS=2
COASTAL_TIMEOUT_MS=2000
COASTAL_FRESHNESS_TTL_SECS=30
# Satellite wildfire stream (#28). Replicas elect one streamer via the SATELIT lease;
# the group token is a secret supplied through the environment, never committed.
SATELLITE_ENABLED=false
SATELLITE_URL=https://satellite.naufarrel.dev
SATELLITE_GROUP_TOKEN=
SATELLITE_LATENESS_MINUTES=360
# Fires this far behind the newest acquisition are closed and dropped from memory.
SATELLITE_STATE_RETENTION_HOURS=48
# Optional JSON file of reference-province centroids used for wildfire area_name.
SATELLITE_PROVINCE_CENTROIDS_FILE=

# ------------------------------------------------------------------------------
# Authentication & Access Control (JWT) & QoS Load Shedding
# ------------------------------------------------------------------------------
AUTH_URL=http://auth:8084
AGGREGATOR_URL=http://aggregator:8083
JWT_SECRET=
JWT_TTL_SECONDS=60
QOS_MAX_CONCURRENT=100
QOS_MEDIA_SHED_THRESHOLD=70
AUTH_MEDIA_CLIENT_ID=test-media-client
AUTH_MEDIA_CLIENT_SECRET=
AUTH_FIELD_CLIENT_ID=test-field-client
AUTH_FIELD_CLIENT_SECRET=
AUTH_INTERNAL_CLIENT_ID=test-internal-client
AUTH_INTERNAL_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Internal Audit API & Sharded Storage Identity (Milestone 2)
# ------------------------------------------------------------------------------
AUDIT_TOKEN=
AUDIT_ALL_SOURCES_LABEL=ALL
NODE_NAME=local
STORAGE_UNIT_ID=shard-1
LEASE_TTL_SECS=15
LEASE_RENEW_INTERVAL_SECS=5
INSTANCE_ID=
DRAIN_DELAY_MS=0
SHARD_CONFIG=
SHARD_TOPOLOGY_JSON=
# PVMBG schema evolution policy (#26). Empty/false reject incompatible changes into the DLQ;
# e.g. PVMBG_FIELD_ALIASES=event_id=report_id and PVMBG_COERCE_NUMERIC_STRINGS=true accept
# the rename_field and type_change modes, after which parked messages are replayed.
PVMBG_FIELD_ALIASES=
PVMBG_COERCE_NUMERIC_STRINGS=false
DLQ_RETRY_BUDGET=5

# Dashboard analytics background resync cadence
DASHBOARD_SYNC_INTERVAL_SECS=5
DASHBOARD_FULL_SYNC_INTERVAL_SECS=300

# ------------------------------------------------------------------------------
# Non-Blocking AI Disaster Situation Summarizer (#36)
# ------------------------------------------------------------------------------
# Optional OpenAI-compatible chat completions endpoint (e.g. http://<ollama-host>:11434/v1/chat/completions)
AI_API_URL=
AI_MODEL=qwen3.5:9b
AI_API_KEY=
AI_DISABLE_THINKING=true
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=120
AI_MAX_CALLS_PER_MIN=12
SUMMARY_MIN_INTERVAL_MS=15000
AI_CB_COOLDOWN_SECS=45

# ------------------------------------------------------------------------------
# Observability (Prometheus, Tempo, Grafana)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
