# ==============================================================================
# BNPB Hazard Aggregation & Early Warning System — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
CLIENT_API_PORT=8080
MOCK_BMKG_PORT=8081
MOCK_PVMBG_PORT=8082
AGGREGATOR_PORT=8083
AUTH_PORT=8084
REDPANDA_PORT=19092

# ------------------------------------------------------------------------------
# Canonical Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=bnpb_user
POSTGRES_PASSWORD=bnpb_secret
POSTGRES_DB=bnpb_hazards
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://bnpb_user:bnpb_secret@canonical-db:5432/bnpb_hazards?sslmode=disable

# ------------------------------------------------------------------------------
# Event Streaming (Redpanda / Kafka)
# ------------------------------------------------------------------------------
REDPANDA_BROKERS=redpanda:9092
KAFKA_TOPIC_HAZARDS=bnpb.hazard-events
KAFKA_TOPIC_PARTITIONS=3
CONSUMER_GROUP_DASHBOARD=bnpb-dashboard-group
CONSUMER_GROUP_NOTIFIER=bnpb-notifier-group

# ------------------------------------------------------------------------------
# Upstream Mock Services & Credentials
# ------------------------------------------------------------------------------
BMKG_URL=http://mock-bmkg:8081
BMKG_API_KEY=bmkg-secret-key-2026

PVMBG_URL=http://mock-pvmbg:8082
PVMBG_TOKEN=pvmbg-bearer-token-2026
# PVMBG response delay in milliseconds (random between MIN and MAX; set both to 3000 for a fixed 3 s)
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000

# ------------------------------------------------------------------------------
# Aggregator Ingestion Worker
# ------------------------------------------------------------------------------
POLL_INTERVAL_SECS=3

# ------------------------------------------------------------------------------
# Authentication & Access Control (JWT)
# ------------------------------------------------------------------------------
AUTH_URL=http://auth:8084
AGGREGATOR_URL=http://aggregator:8083
JWT_SECRET=super-secret-jwt-key-2026
JWT_TTL_SECONDS=60
AUTH_MEDIA_CLIENT_ID=test-media-client
AUTH_MEDIA_CLIENT_SECRET=media-secret-2026
AUTH_FIELD_CLIENT_ID=test-field-client
AUTH_FIELD_CLIENT_SECRET=field-secret-2026
AUTH_INTERNAL_CLIENT_ID=test-internal-client
AUTH_INTERNAL_CLIENT_SECRET=internal-secret-2026
