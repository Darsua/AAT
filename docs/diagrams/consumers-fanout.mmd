flowchart TD
    AGG["aggregator: transactional outbox relay"]
    RP["redpanda: topic bnpb.hazard-events"]
    DASH["dashboard-consumer: process-local type and severity counters"]
    NOTI["notifier-consumer: alert decisions in logs only"]
    LIMIT["Both: unbounded local seen-ID sets; reset on restart; later same-ID updates skipped"]

    AGG -->|"publish hazard payloads"| RP
    RP -->|"group bnpb-dashboard-group"| DASH
    RP -->|"group bnpb-notifier-group"| NOTI
    DASH -.-> LIMIT
    NOTI -.-> LIMIT
