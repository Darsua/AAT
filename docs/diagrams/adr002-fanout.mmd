        RELAY["Outbox relay<br/>kafka-go Writer<br/>balancer Hash, key = hazard_id<br/>RequiredAcks = 1"]:::svc
    end

    subgraph BROKER["redpanda"]
        TOPIC[["bnpb.hazard-events<br/>3 partitions<br/>append-only log"]]:::broker
